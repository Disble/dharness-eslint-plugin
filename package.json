{
  "name": "dharness-eslint-plugin",
  "version": "0.1.0",
  "description": "The guardrails dharness enforces on generated code: file size, documentation, and role-file shape. Loadable by ESLint and by react-doctor.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate": "bun run typecheck && bun run test",
    "prepublishOnly": "bun run validate && bun run build"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.17.0",
    "tsdown": "^0.9.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  }
}

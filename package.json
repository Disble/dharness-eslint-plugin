{
  "name": "dharness-eslint-plugin",
  "version": "0.2.1",
  "description": "The guardrails dharness enforces on generated code: file size, documentation, and role-file shape. Loadable by ESLint and by react-doctor.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Disble/dharness-eslint-plugin.git"
  },
  "homepage": "https://github.com/Disble/dharness-eslint-plugin#readme",
  "bugs": {
    "url": "https://github.com/Disble/dharness-eslint-plugin/issues"
  },
  "keywords": [
    "eslint",
    "eslint-plugin",
    "react-doctor",
    "typescript",
    "architecture",
    "lint",
    "jsdoc",
    "dharness"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "bun run build && eslint src",
    "test": "vitest run",
    "e2e:pack": "node ./scripts/pack-e2e.mjs",
    "validate": "bun run typecheck && bun run lint && bun run test",
    "prepublishOnly": "bun run validate && bun run build"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.17.0",
    "tsdown": "^0.9.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.0"
  }
}
